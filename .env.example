# Copy this file to .env for local development (never commit the real .env).
# On your hosting platform, set these as actual environment variables in
# its dashboard instead of uploading this file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# The Sheet's ID — the long string in its URL between /d/ and /edit
GOOGLE_SHEET_ID=

# EITHER set this to a local file path (simplest for local dev)...
GOOGLE_SHEETS_CREDS_PATH=instance/gsheets-creds.json

# ...OR paste the entire contents of the service account JSON key here as
# one line (simplest for hosts where you can't upload a file, e.g. Render
# free tier without a persistent disk). If this is set, it's used instead
# of GOOGLE_SHEETS_CREDS_PATH.
GOOGLE_SHEETS_CREDS_JSON=

# Optional — defaults to 0.16 (16%) if not set
TAX_RATE=0.16

# Google Sign-In (separate OAuth Client ID, not the Sheets service account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
